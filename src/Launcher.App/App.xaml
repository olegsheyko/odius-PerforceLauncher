<Application x:Class="PerforceLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:PerforceLauncher.App.Infrastructure"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Dark">
    <Application.Resources>
        <!-- ============ Палитра: монохром под логотип, глубокий почти-чёрный, тонкие границы ============ -->
        <SolidColorBrush x:Key="AppBg" Color="#0F0F11"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#0A0A0C"/>
        <SolidColorBrush x:Key="CardBg" Color="#151518"/>
        <SolidColorBrush x:Key="CardBorder" Color="#232328"/>
        <SolidColorBrush x:Key="Divider" Color="#1C1C21"/>
        <SolidColorBrush x:Key="HoverBg" Color="#18181C"/>
        <SolidColorBrush x:Key="SelectedBg" Color="#1E1E23"/>
        <SolidColorBrush x:Key="SubtleFill" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="LogBg" Color="#09090B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B4B4BD"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7A7A85"/>
        <SolidColorBrush x:Key="Warn" Color="#F5B547"/>
        <SolidColorBrush x:Key="Danger" Color="#F2555A"/>
        <SolidColorBrush x:Key="Ok" Color="#3DD68C"/>

        <!-- Системный акцент Fluent (по умолчанию цвет Windows) заменяем на «платиновый» белый -->
        <Color x:Key="SystemAccentColor">#E9E9EC</Color>
        <Color x:Key="SystemAccentColorLight1">#F0F0F2</Color>
        <Color x:Key="SystemAccentColorLight2">#F6F6F7</Color>
        <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>
        <Color x:Key="SystemAccentColorDark1">#D4D4D8</Color>
        <Color x:Key="SystemAccentColorDark2">#BDBDC4</Color>
        <Color x:Key="SystemAccentColorDark3">#A1A1AA</Color>
        <!-- Кисти, которые Fluent запекает из системного акцента: задаём явно -->
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F2F2F3"/>
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E2E2E5"/>
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D0D0D5"/>
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#F2F2F3"/>
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E2E2E5"/>
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D0D0D5"/>
        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#111113"/>
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#111113"/>
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#1A000000"/>
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#111113"/>
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#D4D4D8"/>
        <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#B4B4BD"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#F2F2F3"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#E2E2E5"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#D0D0D5"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#F2F2F3"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#E2E2E5"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#D0D0D5"/>
        <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#5A5A66"/>
        <!-- Подчёркивание полей ввода в фокусе (иначе оранжевый системный акцент) -->
        <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#D4D4D8"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#D4D4D8"/>
        <SolidColorBrush x:Key="DatePickerFocusedBorderBrush" Color="#D4D4D8"/>
        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="#F4F4F5"/>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <inf:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <inf:HasValueToVisibilityConverter x:Key="HasValueToVis"/>

        <!-- Неявный стиль Window не действует на наследников, поэтому окна ссылаются на этот ключ -->
        <Style x:Key="AppWindow" TargetType="Window">
            <Setter Property="Background" Value="{StaticResource AppBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============ Кнопки ============ -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Прозрачная кнопка: подсветка только при наведении -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <!-- Иконочный шрифт только у самого значка: если задать его кнопке, его унаследуют подсказки,
                 меню и любой другой текст «внутри» кнопки, и вместо букв будут квадратики -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{StaticResource IconFont}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Кнопки заголовка окна (своя шапка через WindowChrome) -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource IconFont}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource IconFont}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#A32417"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Подсказка наследует шрифт владельца: у иконочных кнопок это Segoe Fluent Icons, и текст превращался
             в квадратики. Задаём текстовый шрифт явно для всех подсказок. -->
        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- То же для меню, привязанных к иконочным кнопкам (меню «…»): иначе пункты рисуются квадратиками -->
        <Style TargetType="ContextMenu" BasedOn="{StaticResource DefaultContextMenuStyle}">
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ============ Типографика ============ -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Поверхности ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style x:Key="CountBadge" TargetType="Border">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1,7,2"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="20"/>
        </Style>

        <!-- ============ Таблицы ============ -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <Style x:Key="FlatGrid" TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
        </Style>

        <!-- Пустое состояние вкладки -->
        <Style x:Key="EmptyState" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- ============ Проекты в сайдбаре ============ -->
        <Style x:Key="ProfileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="10,9"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="-1,0,0,0" Visibility="Collapsed"
                                    Background="{StaticResource TextPrimary}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SelectedBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладки: текст + тонкая линия под выбранной -->
        <Style x:Key="UnderlineTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,24,0" Background="Transparent">
                            <ContentPresenter ContentSource="Header" Margin="2,12,2,12" VerticalAlignment="Center"/>
                            <Border x:Name="Line" Height="2" CornerRadius="1" VerticalAlignment="Bottom"
                                    Background="{StaticResource TextPrimary}" Visibility="Hidden"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Line" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
