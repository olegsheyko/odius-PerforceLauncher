<Window x:Class="PerforceLauncher.App.Views.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clean Up Disk" Icon="/PerforceLauncher;component/Assets/app.ico" Style="{StaticResource AppWindow}"
        Width="760" Height="620" MinWidth="620" MinHeight="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20,16,20,16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Padding="18,6"/>
            <Button DockPanel.Dock="Right" Content="Delete Selected…" Command="{Binding DeleteCommand}" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Measure Again" Command="{Binding RescanCommand}" HorizontalAlignment="Left"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Clean up generated files" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                       Text="These folders are created by Unreal and can be rebuilt. Your Content, Source and Config are never touched. Close the editor first."/>
            <TextBlock Text="{Binding SelectedText}" Margin="0,8,0,0" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ok}" FontSize="12" Margin="0,4,0,0"
                       Visibility="{Binding Status, Converter={StaticResource HasValueToVis}}"/>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="10" Background="#0AFFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextSecondary}"/>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding Exists}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
