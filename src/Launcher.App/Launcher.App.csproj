<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PerforceLauncher.App</RootNamespace>
    <AssemblyName>PerforceLauncher</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Fluent-тема WPF (ThemeMode) в .NET 9 помечена как экспериментальная -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Версия по умолчанию; в CI берётся из git-тега (vX.Y.Z) через -p:Version -->
    <Version>1.0.0</Version>
    <Product>Perforce Launcher</Product>
    <Company>ODIUS</Company>
    <!-- Своя точка входа: Velopack должен отработать до запуска WPF -->
    <StartupObject>PerforceLauncher.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
