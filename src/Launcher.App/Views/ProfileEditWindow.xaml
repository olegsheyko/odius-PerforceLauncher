<Window x:Class="PerforceLauncher.App.Views.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Settings" Icon="/Assets/app.ico" Style="{StaticResource AppWindow}" Width="640" Height="720" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" IsDefault="True" Click="Ok_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,8,8"/>
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="0,0,0,8"/>
                    </Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="MinWidth" Value="40"/>
                        <Setter Property="Margin" Value="8,0,0,8"/>
                        <Setter Property="Padding" Value="10,3"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="Name"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name}"/>

                <TextBlock Grid.Row="1" Text="P4 server (P4PORT)"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PortBox" Text="{Binding P4Port}" ToolTip="Empty = from environment / p4 set / P4CONFIG"/>

                <TextBlock Grid.Row="2" Text="P4 user"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="UserBox" Text="{Binding P4User}" ToolTip="Empty = from environment / p4 set / P4CONFIG"/>

                <TextBlock Grid.Row="3" Text="Workspace (P4CLIENT)"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ClientBox" IsEditable="True" Margin="0,0,0,8"
                          Text="{Binding P4Client, UpdateSourceTrigger=LostFocus}" DisplayMemberPath="Name"
                          SelectionChanged="ClientBox_SelectionChanged"/>
                <Button Grid.Row="3" Grid.Column="2" Content="Load" Click="LoadClients_Click" ToolTip="Fetch workspaces from server"/>

                <TextBlock Grid.Row="4" Text="Workspace root"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WorkspaceRoot}"/>
                <Button Grid.Row="4" Grid.Column="2" Content="..." Click="BrowseRoot_Click"/>

                <TextBlock Grid.Row="5" Text=".uproject"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="UProjectBox" Text="{Binding UProjectRelativePath}" ToolTip="Relative to workspace root. Empty = auto-detect"/>
                <Button Grid.Row="5" Grid.Column="2" Content="..." Click="BrowseUProject_Click"/>

                <TextBlock Grid.Row="6" Text=".sln (optional)"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="SlnBox" Text="{Binding SolutionRelativePath}" ToolTip="Empty = auto-detect"/>
                <Button Grid.Row="6" Grid.Column="2" Content="..." Click="BrowseSln_Click"/>

                <TextBlock Grid.Row="7" Text="Engine root (optional)"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="EngineBox" Text="{Binding EngineRootOverride}" ToolTip="Empty = detect from EngineAssociation"/>
                <Button Grid.Row="7" Grid.Column="2" Content="..." Click="BrowseEngine_Click"/>

                <TextBlock Grid.Row="8" Text="IDE exe (optional)"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="IdeBox" Text="{Binding IdePath}" ToolTip="Rider/devenv. Empty = default app for .sln"/>
                <Button Grid.Row="8" Grid.Column="2" Content="..." Click="BrowseIde_Click"/>

                <TextBlock Grid.Row="9" Text="Depot scope (optional)"/>
                <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ScopeBox" Text="{Binding DepotScope}" ToolTip="e.g. //depot/Game/Main/... ; empty = whole workspace view"/>

                <TextBlock Grid.Row="10" Text="Poll interval (sec)"/>
                <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PollIntervalSeconds}"/>

                <TextBlock Grid.Row="11" Text=""/>
                <CheckBox Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Content="Notify about new commits" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="12" Text="Custom actions" VerticalAlignment="Top"/>
                <StackPanel Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2">
                    <DataGrid x:Name="ActionsGrid" AutoGenerateColumns="False" CanUserAddRows="True" Height="130"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="110"/>
                            <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*"/>
                            <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Tokens: {Root} {UProject} {Solution} {Client} {Engine}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
