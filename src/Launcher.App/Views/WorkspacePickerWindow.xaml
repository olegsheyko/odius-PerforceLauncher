<Window x:Class="PerforceLauncher.App.Views.WorkspacePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch Workspace" Icon="/PerforceLauncher;component/Assets/app.ico" Style="{StaticResource AppWindow}" Width="720" Height="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Switch" IsDefault="True" Click="Ok_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Text="Loading workspaces..." Margin="0,0,0,8" TextWrapping="Wrap"/>
        <DataGrid x:Name="List" Style="{StaticResource FlatGrid}" SelectionMode="Single" MouseDoubleClick="List_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Workspace" Binding="{Binding Name}" Width="190"/>
                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="120"/>
                <DataGridTextColumn Header="Root" Binding="{Binding Root}" Width="*"/>
                <DataGridTextColumn Header="Stream" Binding="{Binding Stream}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
