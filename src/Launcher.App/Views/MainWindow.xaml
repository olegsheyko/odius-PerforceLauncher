<Window x:Class="PerforceLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perforce Launcher" Icon="/Assets/app.ico" Style="{StaticResource AppWindow}"
        Width="1280" Height="840" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <!-- Своя шапка: сайдбар и контент доходят до верхнего края окна -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding LaunchPrimaryCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ToggleLogCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Сайдбар ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Бренд (зона перетаскивания окна) -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,16,16,26">
                    <Image Source="/Assets/app.ico" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Perforce Launcher" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="for Unreal Engine" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="22,0,12,6">
                    <TextBlock Text="PROJECTS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Content="&#xE710;" Command="{Binding AddProfileCommand}" ToolTip="Add project"/>
                </Grid>

                <!-- Подвал -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="10,8">
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding SettingsCommand}" ToolTip="Launcher settings: p4 path, tray, start with Windows">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="14" Margin="2,0,10,0"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </Border>

                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" Margin="10,0,10,8"
                         ItemContainerStyle="{StaticResource ProfileItem}" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="{Binding AvatarBrush}">
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource Warn}" CornerRadius="9" MinWidth="20" Padding="6,1,6,2"
                                        VerticalAlignment="Center" Visibility="{Binding IsBehind, Converter={StaticResource BoolToVis}}"
                                        ToolTip="New commits on the server">
                                    <TextBlock Text="{Binding BehindText}" Foreground="#141414" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Основная область ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка окна -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                    <TextBlock Text="Projects" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    <TextBlock Text="  /  " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    <TextBlock Text="{Binding Selected.Name}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close to tray"/>
                </StackPanel>
                <!-- Индикатор работы: проверка, sync, reconcile, submit -->
                <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" VerticalAlignment="Bottom" Margin="0" Background="Transparent" BorderThickness="0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding Selected.IsChecking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>

            <!-- Контент выбранного проекта -->
            <Grid Grid.Row="1" Margin="32,10,32,20" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок проекта -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" CornerRadius="14" Background="{Binding Selected.AvatarBrush}">
                        <TextBlock Text="{Binding Selected.Initials}" Foreground="White" FontSize="19" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Background="{StaticResource SubtleFill}" CornerRadius="6" Padding="8,2,8,3" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding Selected.EngineLabel, Converter={StaticResource HasValueToVis}}" ToolTip="Engine from EngineAssociation in the .uproject">
                                <TextBlock Text="{Binding Selected.EngineLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="-6,4,0,0">
                            <Button Style="{StaticResource GhostButton}" Command="{Binding SwitchWorkspaceCommand}" Padding="6,3" MinHeight="0"
                                    ToolTip="Switch workspace…">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,1,7,0"/>
                                    <TextBlock Text="{Binding Selected.Subtitle}" FontSize="12.5"/>
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9" Margin="7,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding Selected.RootText}" Foreground="{StaticResource TextMuted}" FontSize="12"
                                       VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding EditProfileCommand}" ToolTip="Project settings…"/>
                        <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Click="MoreButton_Click" ToolTip="More" Margin="4,0,0,0">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Switch Workspace…" Command="{Binding SwitchWorkspaceCommand}"/>
                                    <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}"/>
                                    <MenuItem Header="Copy Workspace Path" Command="{Binding CopyCommand}" CommandParameter="{Binding Selected.Model.WorkspaceRoot}"/>
                                    <MenuItem Header="Check for Updates" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
                                    <MenuItem Header="Sign In to Perforce…" Command="{Binding LoginCommand}"
                                              ToolTip="Sign in now and optionally remember the password for automatic sign-in"/>
                                    <Separator/>
                                    <MenuItem Header="Remove Project…" Command="{Binding RemoveProfileCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Статус + сводка -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="18,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Selected.StateTint}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.StateGlyph}" Style="{StaticResource Glyph}" FontSize="16"
                                           Foreground="{Binding Selected.StateBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.StatusTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Selected.StatusSubtitle}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.StatusSubtitle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Get Latest: акцентная, когда есть что забрать -->
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SyncCommand}" ToolTip="Get latest revisions (p4 sync)"
                                        Visibility="{Binding Selected.IsBehind, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,1,8,0"/>
                                        <TextBlock Text="Get Latest"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SyncCommand}" ToolTip="Get latest revisions (p4 sync)"
                                        Visibility="{Binding Selected.IsBehind, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,1,8,0"/>
                                        <TextBlock Text="Get Latest"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding Selected.AuthRequired, Converter={StaticResource BoolToVis}}" Content="Sign In…"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}"
                                        Margin="6,0,0,0" ToolTip="Check for updates (F5)"/>
                            </StackPanel>
                        </Grid>
                        <!-- Сводка -->
                        <Border Grid.Column="1" BorderBrush="{StaticResource Divider}" BorderThickness="1,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="6,0,10,0" VerticalAlignment="Center">
                                <StackPanel Margin="16,0" MinWidth="78">
                                    <TextBlock Text="SYNCED" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Selected.HaveText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" FontFamily="{StaticResource DisplayFont}"/>
                                </StackPanel>
                                <StackPanel Margin="16,0" MinWidth="78">
                                    <TextBlock Text="ON SERVER" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Selected.LatestText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" FontFamily="{StaticResource DisplayFont}"/>
                                </StackPanel>
                                <StackPanel Margin="16,0" MinWidth="88">
                                    <TextBlock Text="LOCAL CHANGES" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding PendingCountText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" FontFamily="{StaticResource DisplayFont}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Подсказки: нет .sln, изменились build-файлы, путь к проекту -->
                <StackPanel Grid.Row="2">
                    <Border Margin="0,10,0,0" Background="#0DFFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="14,8,8,8" Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="14"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="10"
                                    Content="&#xE711;" Command="{Binding DismissHintCommand}" ToolTip="Dismiss"/>
                            <Button DockPanel.Dock="Right" Content="Generate Project Files" Command="{Binding HintCommand}" Padding="12,5" Margin="8,0,4,0"/>
                            <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding Selected.PathWarning}" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="2,8,0,0"
                               Visibility="{Binding Selected.PathWarning, Converter={StaticResource HasValueToVis}}"/>
                </StackPanel>

                <!-- Запуск -->
                <WrapPanel Grid.Row="3" Margin="0,20,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrimaryAction.Command}" MinWidth="230" Padding="18,9" Margin="0,0,10,0"
                            ToolTip="{Binding PrimaryAction.ToolTipText}" ToolTipService.ShowOnDisabled="True" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="18" Margin="0,0,13,0"/>
                            <StackPanel>
                                <TextBlock Text="Launch Unreal" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PrimaryAction.Detail}" FontSize="11.5" FontWeight="Normal" Opacity="0.65"
                                           Visibility="{Binding PrimaryAction.Detail, Converter={StaticResource HasValueToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding SecondaryActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding Command}" ToolTip="{Binding ToolTipText}" ToolTipService.ShowOnDisabled="True"
                                        Padding="16,0" MinHeight="54" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <!-- Вкладки -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,22,0,0" Padding="18,4,18,12">
                    <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" Padding="0"
                                SelectionChanged="MainTabs_SelectionChanged" ItemContainerStyle="{StaticResource UnderlineTab}">

                        <!-- Входящие коммиты -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Incoming"/>
                                    <Border Style="{StaticResource CountBadge}" Visibility="{Binding Selected.Behind, Converter={StaticResource HasValueToVis}}">
                                        <TextBlock Text="{Binding Selected.BehindText}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="0,8,0,0">
                                <DataGrid x:Name="IncomingGrid" ItemsSource="{Binding Selected.NewChanges}" Style="{StaticResource FlatGrid}">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy CL Number" Command="{Binding CopyCommand}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Copy Description" Command="{Binding CopyCommand}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem.Description, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CL" Binding="{Binding Id}" Width="80"/>
                                        <DataGridTextColumn Header="AUTHOR" Binding="{Binding User}" Width="130"/>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding Time, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding FirstLine}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding HasItems, ElementName=IncomingGrid, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{StaticResource Ok}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="You're up to date" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,2" HorizontalAlignment="Center"/>
                                    <TextBlock Text="New commits from your team will show up here." Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <!-- Локальные изменения / submit -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Pending"/>
                                    <Border Style="{StaticResource CountBadge}" Visibility="{Binding PendingCount, Converter={StaticResource HasValueToVis}}">
                                        <TextBlock Text="{Binding PendingCount}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel Margin="0,12,0,0">
                                <WrapPanel DockPanel.Dock="Top">
                                    <WrapPanel.Resources>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Padding" Value="11,5"/>
                                            <Setter Property="Margin" Value="0,0,6,6"/>
                                        </Style>
                                    </WrapPanel.Resources>
                                    <Button Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" Padding="14,5" Margin="0,0,12,6"
                                            ToolTip="Submit the selected changelist (or the only non-empty one)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,1,8,0"/>
                                            <TextBlock Text="Submit…"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Reconcile Offline Work" Command="{Binding ReconcileCommand}"
                                            ToolTip="Find files changed outside Perforce (edited without checkout, added or deleted) and open them for submit"/>
                                    <Button Content="New Changelist…" Command="{Binding NewChangelistCommand}"/>
                                    <Button x:Name="MoveButton" Content="Move To  ▾" Click="MoveButton_Click" ToolTip="Move the selected files to another changelist"/>
                                    <Button Content="Edit Description…" Command="{Binding EditDescriptionCommand}"/>
                                    <Button Content="Delete Changelist" Command="{Binding DeleteChangelistCommand}" ToolTip="Delete an empty numbered changelist"/>
                                    <Button Content="Revert…" Command="{Binding RevertCommand}" ToolTip="Discard local changes in the selected files"/>
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding PendingError}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Visibility="{Binding PendingError, Converter={StaticResource HasValueToVis}}"/>
                                <Grid>
                                    <DataGrid x:Name="PendingList" ItemsSource="{Binding PendingFiles}" Style="{StaticResource FlatGrid}"
                                              SelectionMode="Extended" SelectionChanged="PendingList_SelectionChanged">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Show in Explorer" Command="{Binding RevealCommand}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem.File.LocalPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Copy Local Path" Command="{Binding CopyCommand}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem.File.LocalPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Copy Depot Path" Command="{Binding CopyCommand}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem.File.DepotPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Revert…" Command="{Binding RevertCommand}"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="4,12,0,4"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.Columns>
                                            <!-- ⚠: файл под .p4ignore, но уже в депо -->
                                            <DataGridTextColumn Header="" Binding="{Binding Marker}" Width="32">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="ToolTip" Value="{Binding MarkerTip}"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="90"/>
                                            <DataGridTextColumn Header="FILE" Binding="{Binding DisplayPath}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                                <Setter Property="ToolTip" Value="{Binding MarkerTip}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding HasItems, ElementName=PendingList, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No local changes" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,2" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Checked-out files appear here. Edited without checkout? Use Reconcile Offline Work."
                                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </TabItem>

                        <!-- История -->
                        <TabItem x:Name="HistoryTab" Header="History">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*" MinHeight="110"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="130" MinHeight="60"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Load More" Command="{Binding LoadMoreHistoryCommand}" Margin="8,0,0,0"
                                            Visibility="{Binding HistoryHasMore, Converter={StaticResource BoolToVis}}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshHistoryCommand}"
                                            Margin="8,0,0,0" ToolTip="Reload history"/>
                                    <Grid>
                                        <TextBox Text="{Binding HistoryFilter, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,8,6"
                                                 ToolTip="Filters the loaded commits by CL number, author or description"/>
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource TextMuted}"
                                                   Margin="12,0,0,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="Search by CL, author or description" Foreground="{StaticResource TextMuted}"
                                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="34,0,0,0"
                                                   Visibility="{Binding HistoryFilter, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HistoryFilter}" Value=""><Setter Property="Opacity" Value="1"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>

                                <DataGrid Grid.Row="1" x:Name="HistoryGrid" ItemsSource="{Binding HistoryView}" Style="{StaticResource FlatGrid}"
                                          SelectionMode="Single" SelectedItem="{Binding SelectedHistory, Mode=TwoWay}">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy CL Number" Command="{Binding CopyCommand}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Copy Description" Command="{Binding CopyCommand}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem.Change.Description, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="Sync Workspace to This Changelist…" Command="{Binding SyncToChangeCommand}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="" Binding="{Binding Marker}" Width="28">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="ToolTip" Value="{Binding MarkerTip}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="CL" Binding="{Binding Id}" Width="80"/>
                                        <DataGridTextColumn Header="AUTHOR" Binding="{Binding User}" Width="130"/>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding Time, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding FirstLine}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="1" Text="{Binding HistoryError}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                                           VerticalAlignment="Top" Margin="4,40,4,0"/>

                                <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>

                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#0AFFFFFF" CornerRadius="8" Padding="2">
                                        <Grid>
                                            <TextBox Text="{Binding HistoryDescription, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Top"/>
                                            <TextBlock Text="Select a commit to see its description and files" Foreground="{StaticResource TextMuted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                                       Visibility="{Binding HistoryDescription, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}"/>
                                        </Grid>
                                    </Border>
                                    <DockPanel Grid.Column="2">
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryFilesInfo}" Style="{StaticResource SectionLabel}" Margin="4,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding HistoryFiles}" Style="{StaticResource FlatGrid}" RowHeight="28">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy Depot Path" Command="{Binding CopyCommand}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.DepotPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="76"/>
                                                <DataGridTextColumn Header="FILE" Binding="{Binding DepotPath}" Width="*"/>
                                                <DataGridTextColumn Header="REV" Binding="{Binding Rev}" Width="52"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- Пустое состояние: нет проектов -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                <Image Source="/Assets/app.ico" Width="76" Height="76" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Add your first project" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                           Margin="0,20,0,6" HorizontalAlignment="Center"/>
                <TextBlock Text="A project is a Perforce workspace with an Unreal project inside." Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Add Project" Command="{Binding AddProfileCommand}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            </StackPanel>

            <!-- Журнал операций -->
            <Border Grid.Row="2" Background="{StaticResource LogBg}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Height="180"
                    Visibility="{Binding IsLogOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="32,8,16,2">
                        <TextBlock Text="ACTIVITY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE8C8;"
                                    Command="{Binding CopyCommand}" CommandParameter="{Binding Output}" ToolTip="Copy log"/>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10" Content="&#xE711;"
                                    Command="{Binding ToggleLogCommand}" ToolTip="Hide (Ctrl+L)"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="LogBox" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             Margin="24,0,12,8" VerticalContentAlignment="Top" TextChanged="LogBox_TextChanged"/>
                </DockPanel>
            </Border>

            <!-- Строка состояния -->
            <Border Grid.Row="3" Height="32" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0">
                <Grid Margin="32,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Perforce connection of this project">
                        <Ellipse Width="7" Height="7" Fill="{Binding Selected.StateBrush}" Margin="0,1,8,0"/>
                        <TextBlock Text="{Binding ConnectionText}" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LastOutputLine}" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                               Margin="24,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BusyText}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelOperationCommand}" Padding="8,2" MinHeight="0"
                                Margin="8,0,0,0" FontSize="11.5" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Command="{Binding ToggleLogCommand}" Padding="8,2" MinHeight="0"
                            ToolTip="Show or hide the activity log (Ctrl+L)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,1,7,0"/>
                            <TextBlock Text="Activity" FontSize="11.5"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
