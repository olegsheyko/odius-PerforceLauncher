<Window x:Class="PerforceLauncher.App.Views.LabelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Labels" Icon="/PerforceLauncher;component/Assets/app.ico" Style="{StaticResource AppWindow}"
        Width="900" Height="580" MinWidth="680" MinHeight="400" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20,16,20,16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Padding="18,6"/>
            <Button DockPanel.Dock="Right" Content="Sync Workspace to This Label…" Command="{Binding SyncCommand}" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,0"
                    ToolTip="Make your workspace match the depot as of this label. Files you have opened are not touched."/>
            <Button Content="Reload" Command="{Binding ReloadCommand}" HorizontalAlignment="Left"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Labels" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
            <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                       Text="Labels mark known states of the project: releases, stable builds, milestones. Pick one to roll your workspace back to it."/>
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="10,6" ToolTip="Filter by name, owner or description"/>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}"/>
        </StackPanel>

        <Grid>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionMode="Single" Style="{StaticResource FlatGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="LABEL" Binding="{Binding Name}" Width="240"/>
                    <DataGridTextColumn Header="OWNER" Binding="{Binding Owner}" Width="110"/>
                    <DataGridTextColumn Header="UPDATED" Binding="{Binding Updated, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE8EC;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                <TextBlock Text="No labels" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,2" HorizontalAlignment="Center"/>
                <TextBlock Text="This server has no labels, or none match the filter." Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
