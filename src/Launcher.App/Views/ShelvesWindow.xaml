<Window x:Class="PerforceLauncher.App.Views.ShelvesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shelves" Icon="/PerforceLauncher;component/Assets/app.ico" Style="{StaticResource AppWindow}"
        Width="920" Height="600" MinWidth="720" MinHeight="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20,16,20,16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" Style="{StaticResource PrimaryButton}" Padding="18,6"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Unshelve to My Workspace…" Command="{Binding UnshelveCommand}" Margin="0,0,8,0"
                        ToolTip="Open the shelved files in your default changelist with the shelved content"/>
                <Button Content="Delete My Shelf…" Command="{Binding DeleteCommand}" Margin="0,0,8,0" ToolTip="Remove your own shelved copy from the server"/>
                <Button Content="Reload" Command="{Binding ReloadCommand}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Shelved changes" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                       Text="A shelf is a copy of changes kept on the server without submitting them. Use it to hand work to a teammate or to switch tasks."/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0"
                       Visibility="{Binding Status, Converter={StaticResource HasValueToVis}}"/>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Height="130" Margin="0,10,0,0" Background="#0AFFFFFF" CornerRadius="8" Padding="2">
            <TextBox Text="{Binding FilesText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
        </Border>

        <Grid>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionMode="Single" Style="{StaticResource FlatGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CL" Binding="{Binding Title}" Width="84"/>
                    <DataGridTextColumn Header="AUTHOR" Binding="{Binding User}" Width="110"/>
                    <DataGridTextColumn Header="DATE" Binding="{Binding Time, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding FirstLine}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE7B8;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                <TextBlock Text="No shelved changes" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,2" HorizontalAlignment="Center"/>
                <TextBlock Text="Right-click a changelist in Pending and choose Shelve Files…" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
